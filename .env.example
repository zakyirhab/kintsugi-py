# ==============================================================================
# KintsugiPy Environment Configuration
# ==============================================================================
# Configure whichever LLM provider you prefer. Kintsugi auto-detects by prefix.

# Groq (Ultra-fast inference with Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Anthropic Claude 3.5 Native
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Google Gemini Native
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# OpenRouter
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# Local LLM (LM Studio / Ollama / vLLM)
KINTSUGI_PROVIDER=local
KINTSUGI_BASE_URL=http://localhost:1234/v1
KINTSUGI_MODEL=qwen2.5-coder-14b-instruct
